# Helvetiq Bank — frontend environment
#
# Copy to `.env.local` for local dev. All VITE_* vars are client-exposed.

# -- Backend wiring -----------------------------------------------------------
# Set to `false` once the real API Gateway is ready.
# While true, all service adapters resolve to their `fake/` implementations
# and MSW intercepts every /api/* request with fixture data.
VITE_USE_MOCKS=true
VITE_AUTH_MODE=legacy

# Browser-facing API base. The API Gateway allows the local Vite origin.
# The gateway is expected to fan out to:
#   identity-service, customer-service, account-service,
#   transaction-service, payment-service, audit-service, notification-service
VITE_API_GATEWAY_URL=http://localhost:8090
VITE_RISK_SERVICE_URL=http://localhost:8091
VITE_OIDC_ISSUER_URL=http://127.0.0.1:8089/realms/banking-platform
VITE_OIDC_CLIENT_ID=helvetiq-frontend

# Vite dev proxy target for local development.
VITE_DEV_PROXY_TARGET=http://localhost:8090

# -- Observability wiring (future) --------------------------------------------
# Placeholder. Not yet wired.
VITE_TRACE_HEADER=X-Correlation-Id

# -- Feature flags ------------------------------------------------------------
VITE_FEATURE_OPS_CONSOLE=true
VITE_FEATURE_QR_BILL=true
VITE_FEATURE_DARK_MODE=true

# -- Locale -------------------------------------------------------------------
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=en,de
